PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/verdict
# Long random string. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# FREE LLM: Groq (no credit card). Key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Free-tier tokens per minute for that model (used for pacing). Check console.groq.com/settings/limits
GROQ_TPM=10000

# FREE web search: Tavily (no credit card, monthly free credits). Key: https://app.tavily.com
# Optional: without it, agents use only your documents and model knowledge.
TAVILY_API_KEY=
